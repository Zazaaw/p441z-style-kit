          "chart-2": "hsl(160 60% 45%)",
          "chart-3": "hsl(30 80% 55%)",
          "chart-4": "hsl(280 65% 60%)",
          "chart-5": "hsl(340 75% 55%)",
          "sb-thumb": "hsl(0 0% 40%)",
          "sb-thumb-hover": "hsl(0 0% 55%)"
        }
      },
      "css": {
        "@keyframes gradient-x": {
          "0%, 100%": {
            "background-position": "0% 50%"
          },
          "50%": {
            "background-position": "100% 50%"
          }
        },
        "@keyframes shine": {
          "from": {
            "background-position": "200% 0"
          },
          "to": {
            "background-position": "-200% 0"
          }
        },
        "@keyframes ripple": {
          "to": {
            "transform": "translate(-50%, -50%) scale(28)",
            "opacity": "0"
          }
        },
        "@keyframes rainbow": {
          "0%": {
            "background-position": "0% 50%"
          },
          "100%": {
            "background-position": "200% 50%"
          }
        },
        "@keyframes border-beam": {
          "100%": {
            "offset-distance": "100%"
          }
        },
        "@keyframes meteor": {
          "0%": {
            "transform": "rotate(215deg) translateX(0)",
            "opacity": "1"
          },
          "70%": {
            "opacity": "1"
          },
          "100%": {
            "transform": "rotate(215deg) translateX(-500px)",
            "opacity": "0"
          }
        },
        "@keyframes grid-scroll": {
          "0%": {
            "transform": "translateY(0)"
          },
          "100%": {
            "transform": "translateY(40px)"
          }
        },
        "@keyframes orbit": {
          "0%": {
            "transform": "rotate(0deg) translateY(calc(var(--radius, 80px) * 1px)) rotate(0deg)"
          },
          "100%": {
            "transform": "rotate(360deg) translateY(calc(var(--radius, 80px) * 1px)) rotate(-360deg)"
          }
        },
        "@keyframes shimmer": {
          "0%, 90%, 100%": {
            "background-position": "calc(-100% - var(--shimmer-width, 100px)) 0"
          },
          "30%, 60%": {
            "background-position": "calc(100% + var(--shimmer-width, 100px)) 0"
          }
        },
        "@keyframes marquee": {
          "from": {
            "transform": "translateX(0)"
          },
          "to": {
            "transform": "translateX(calc(-100% - var(--gap, 1rem)))"
          }
        },
        "@keyframes marquee-vertical": {
          "from": {
            "transform": "translateY(0)"
          },
          "to": {
            "transform": "translateY(calc(-100% - var(--gap, 1rem)))"
          }
        },
        "@keyframes spin-around": {
          "0%": {
            "transform": "translateZ(0) rotate(0)"
          },
          "15%, 35%": {
            "transform": "translateZ(0) rotate(90deg)"
          },
          "65%, 85%": {
            "transform": "translateZ(0) rotate(270deg)"
          },
          "100%": {
            "transform": "translateZ(0) rotate(360deg)"
          }
        },
        "@keyframes slide": {
          "to": {
            "transform": "translate(calc(100cqw - 100%), 0)"
          }
        },
        "@layer base": {
          "*, ::after, ::before, ::backdrop, ::file-selector-button": {
            "border-color": "var(--border)"
          },
          "body": {
            "background-color": "var(--background)",
            "color": "var(--foreground)"
          },
          "::-webkit-scrollbar": {
            "width": "var(--sb-size)",
            "height": "var(--sb-size)"
          },
          "::-webkit-scrollbar-track": {
            "background": "transparent",
            "border-radius": "9999px"
          },
          "::-webkit-scrollbar-thumb": {
            "background-color": "color-mix(in oklab, var(--sb-thumb) 45%, transparent)",
            "border-radius": "9999px",
            "border": "3px solid transparent",
            "background-clip": "content-box",
            "transition": "background-color 0.2s ease"
          },
          "::-webkit-scrollbar-thumb:hover": {
            "background-color": "color-mix(in oklab, var(--sb-thumb-hover) 70%, transparent)"
          },
          "::-webkit-scrollbar-thumb:active": {
            "background-color": "color-mix(in oklab, var(--sb-thumb-hover) 85%, transparent)"
          },
          "::-webkit-scrollbar-corner": {
            "background": "transparent"
          },
          "*": {
            "scrollbar-width": "thin",
            "scrollbar-color": "color-mix(in oklab, var(--sb-thumb) 50%, transparent) transparent"
          }
        }
      }
    },
