{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "p441z theme",
  "description": "Greyscale tokens (HSL triplets), the hsl() color mapping, radius scale, 13 animations with keyframes, and the pill scrollbar.",
  "dependencies": [
    "tw-animate-css"
  ],
  "cssVars": {
    "theme": {
      "radius-sm": "calc(var(--radius) - 4px)",
      "radius-md": "calc(var(--radius) - 2px)",
      "radius-lg": "var(--radius)",
      "animate-shimmer": "shimmer 8s infinite",
      "animate-marquee": "marquee var(--duration, 20s) linear infinite",
      "animate-marquee-vertical": "marquee-vertical var(--duration, 20s) linear infinite",
      "animate-spin-around": "spin-around calc(var(--speed, 2s) * 2) infinite linear",
      "animate-slide": "slide var(--speed, 4s) ease-in-out infinite alternate",
      "animate-gradient-x": "gradient-x 4s ease infinite",
      "animate-spin-slow": "spin 4s linear infinite",
      "animate-shine": "shine 3s linear infinite",
      "animate-ripple": "ripple 0.6s ease-out",
      "animate-rainbow": "rainbow 3s linear infinite",
      "animate-border-beam": "border-beam var(--duration, 4s) linear infinite",
      "animate-meteor": "meteor 5s linear infinite",
      "animate-orbit": "orbit var(--duration, 20s) linear infinite"
    },
    "light": {
      "background": "hsl(0 0% 100%)",
      "foreground": "hsl(0 0% 3.9%)",
      "card": "hsl(0 0% 100%)",
      "card-foreground": "hsl(0 0% 3.9%)",
      "popover": "hsl(0 0% 100%)",
      "popover-foreground": "hsl(0 0% 3.9%)",
      "primary": "hsl(0 0% 9%)",
      "primary-foreground": "hsl(0 0% 98%)",
      "secondary": "hsl(0 0% 96.1%)",
      "secondary-foreground": "hsl(0 0% 9%)",
      "muted": "hsl(0 0% 96.1%)",
      "muted-foreground": "hsl(0 0% 45.1%)",
      "accent": "hsl(0 0% 96.1%)",
      "accent-foreground": "hsl(0 0% 9%)",
      "destructive": "hsl(0 84.2% 60.2%)",
      "destructive-foreground": "hsl(0 0% 98%)",
      "border": "hsl(0 0% 89.8%)",
      "input": "hsl(0 0% 89.8%)",
      "ring": "hsl(0 0% 3.9%)",
      "chart-1": "hsl(12 76% 61%)",
      "chart-2": "hsl(173 58% 39%)",
      "chart-3": "hsl(197 37% 24%)",
      "chart-4": "hsl(43 74% 66%)",
      "chart-5": "hsl(27 87% 67%)",
      "radius": "0.5rem",
      "sb-size": "12px",
      "sb-thumb": "hsl(0 0% 60%)",
      "sb-thumb-hover": "hsl(0 0% 45%)"
    },
    "dark": {
      "background": "hsl(0 0% 3.9%)",
      "foreground": "hsl(0 0% 98%)",
      "card": "hsl(0 0% 3.9%)",
      "card-foreground": "hsl(0 0% 98%)",
      "popover": "hsl(0 0% 3.9%)",
      "popover-foreground": "hsl(0 0% 98%)",
      "primary": "hsl(0 0% 98%)",
      "primary-foreground": "hsl(0 0% 9%)",
      "secondary": "hsl(0 0% 14.9%)",
      "secondary-foreground": "hsl(0 0% 98%)",
      "muted": "hsl(0 0% 14.9%)",
      "muted-foreground": "hsl(0 0% 63.9%)",
      "accent": "hsl(0 0% 14.9%)",
      "accent-foreground": "hsl(0 0% 98%)",
      "destructive": "hsl(0 62.8% 30.6%)",
      "destructive-foreground": "hsl(0 0% 98%)",
      "border": "hsl(0 0% 14.9%)",
      "input": "hsl(0 0% 14.9%)",
      "ring": "hsl(0 0% 83.1%)",
      "chart-1": "hsl(220 70% 50%)",
      "chart-2": "hsl(160 60% 45%)",
      "chart-3": "hsl(30 80% 55%)",
      "chart-4": "hsl(280 65% 60%)",
      "chart-5": "hsl(340 75% 55%)",
      "sb-thumb": "hsl(0 0% 40%)",
      "sb-thumb-hover": "hsl(0 0% 55%)"
    }
  },
  "css": {
    "@keyframes gradient-x": {
      "0%, 100%": {
        "background-position": "0% 50%"
      },
      "50%": {
        "background-position": "100% 50%"
      }
    },
    "@keyframes shine": {
      "from": {
        "background-position": "200% 0"
      },
      "to": {
        "background-position": "-200% 0"
      }
    },
    "@keyframes ripple": {
      "to": {
        "transform": "translate(-50%, -50%) scale(28)",
        "opacity": "0"
      }
    },
    "@keyframes rainbow": {
      "0%": {
        "background-position": "0% 50%"
      },
      "100%": {
        "background-position": "200% 50%"
      }
    },
    "@keyframes border-beam": {
      "100%": {
        "offset-distance": "100%"
      }
    },
    "@keyframes meteor": {
      "0%": {
        "transform": "rotate(215deg) translateX(0)",
        "opacity": "1"
      },
      "70%": {
        "opacity": "1"
      },
      "100%": {
        "transform": "rotate(215deg) translateX(-500px)",
        "opacity": "0"
      }
    },
    "@keyframes grid-scroll": {
      "0%": {
        "transform": "translateY(0)"
      },
      "100%": {
        "transform": "translateY(40px)"
      }
    },
    "@keyframes orbit": {
      "0%": {
        "transform": "rotate(0deg) translateY(calc(var(--radius, 80px) * 1px)) rotate(0deg)"
      },
      "100%": {
        "transform": "rotate(360deg) translateY(calc(var(--radius, 80px) * 1px)) rotate(-360deg)"
      }
    },
    "@keyframes shimmer": {
      "0%, 90%, 100%": {
        "background-position": "calc(-100% - var(--shimmer-width, 100px)) 0"
      },
      "30%, 60%": {
        "background-position": "calc(100% + var(--shimmer-width, 100px)) 0"
      }
    },
    "@keyframes marquee": {
      "from": {
        "transform": "translateX(0)"
      },
      "to": {
        "transform": "translateX(calc(-100% - var(--gap, 1rem)))"
      }
    },
    "@keyframes marquee-vertical": {
      "from": {
        "transform": "translateY(0)"
      },
      "to": {
        "transform": "translateY(calc(-100% - var(--gap, 1rem)))"
      }
    },
    "@keyframes spin-around": {
      "0%": {
        "transform": "translateZ(0) rotate(0)"
      },
      "15%, 35%": {
        "transform": "translateZ(0) rotate(90deg)"
      },
      "65%, 85%": {
        "transform": "translateZ(0) rotate(270deg)"
      },
      "100%": {
        "transform": "translateZ(0) rotate(360deg)"
      }
    },
    "@keyframes slide": {
      "to": {
        "transform": "translate(calc(100cqw - 100%), 0)"
      }
    },
    "@layer base": {
      "*, ::after, ::before, ::backdrop, ::file-selector-button": {
        "border-color": "var(--border)"
      },
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      },
      "::-webkit-scrollbar": {
        "width": "var(--sb-size)",
        "height": "var(--sb-size)"
      },
      "::-webkit-scrollbar-track": {
        "background": "transparent",
        "border-radius": "9999px"
      },
      "::-webkit-scrollbar-thumb": {
        "background-color": "color-mix(in oklab, var(--sb-thumb) 45%, transparent)",
        "border-radius": "9999px",
        "border": "3px solid transparent",
        "background-clip": "content-box",
        "transition": "background-color 0.2s ease"
      },
      "::-webkit-scrollbar-thumb:hover": {
        "background-color": "color-mix(in oklab, var(--sb-thumb-hover) 70%, transparent)"
      },
      "::-webkit-scrollbar-thumb:active": {
        "background-color": "color-mix(in oklab, var(--sb-thumb-hover) 85%, transparent)"
      },
      "::-webkit-scrollbar-corner": {
        "background": "transparent"
      },
      "*": {
        "scrollbar-width": "thin",
        "scrollbar-color": "color-mix(in oklab, var(--sb-thumb) 50%, transparent) transparent"
      }
    }
  },
  "type": "registry:theme"
}